# Secrets - never upload
.env
.streamlit/secrets.toml

# Your private data (leads, edits, clients, your phone number in templates)
leads.db
leads.db-*
cache.json
clients.json
outreach_settings.json
*.tmp
*.zip

# Python
__pycache__/
*.pyc
.venv/
venv/

# Run outputs and logs - regenerable, and they embed your own contact details
last_*
*.log
*.err

# Lighthouse QA reports - regenerable, ~4MB of noise
lh-*.report.json
lh-*.report.html

# Scraped third-party source material (edshair.co.uk HTML dumps).
